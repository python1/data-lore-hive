{
  "name": "@python1/verified-memory-mcp",
  "version": "0.3.0",
  "description": "Local read-only stdio MCP server for checksum-verified, optionally signed memory packs",
  "mcpName": "io.github.python1/verified-memory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/python1/data-lore-hive.git",
    "directory": "plugins/verified-memory-mcp"
  },
  "bin": {
    "verified-memory-mcp": "dist/index.js",
    "verified-memory-build-pack": "tools/build-pack.mjs"
  },
  "files": [
    "dist",
    "tools/build-pack.mjs",
    "tools/pack-core.mjs",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "funding": "https://buymeacoffee.com/python1",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/prepare.mjs && tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "test:mcpb": "npm run build:mcpb && node --test test/mcpb/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
