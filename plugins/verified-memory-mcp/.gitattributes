# Pack files and their inputs are verified or rebuilt byte for byte (SHA256SUMS, message
# hashes, golden packs), so Git must never rewrite their line endings, e.g. core.autocrlf
# on Windows.
examples/** -text
web/test/fixtures/** -text
web/test/golden/** -text
# The npm bin scripts start with a shebang; a CRLF checkout would make it
# "#!/usr/bin/env node\r", which fails on macOS and Linux if published from Windows.
tools/*.mjs text eol=lf
